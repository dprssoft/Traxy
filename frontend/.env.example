# Frontend env example — copy this to .env and fill in your values.
#
# API keys are entered by the user in the app's Settings page.
# You can also set them here as a developer convenience — they will NOT
# be shipped in the git repo or exposed to other users.
#
# VITE_TMDB_API_KEY=           # https://www.themoviedb.org/settings/api
# VITE_IGDB_CLIENT_ID=         # https://dev.twitch.tv/console
# VITE_IGDB_CLIENT_SECRET=     # https://dev.twitch.tv/console
# VITE_COMICVINE_API_KEY=      # https://comicvine.gamespot.com/api